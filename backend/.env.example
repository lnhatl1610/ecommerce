# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db"

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# CORS (comma-separated origins for dashboard/web)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cookies (set true in production behind HTTPS)
COOKIE_SECURE=false

# Payment callback signing
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Cloudinary direct upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (optional Resend)
RESEND_API_KEY=
EMAIL_FROM=Store <orders@example.com>
WEB_URL=http://localhost:5174
